# Copy to .env and adjust. Never commit .env.

# PostgreSQL credentials used by docker compose.
POSTGRES_DB=analyzer
POSTGRES_USER=analyzer
POSTGRES_PASSWORD=change-me

# Optional GitHub token (no scopes needed for public repositories).
# Raises the rate limit from 60 to 5000 requests/hour. Leave empty to run anonymously.
GITHUB_TOKEN=

# Analysis tuning
COMMIT_WINDOW_DAYS=365
# Each page is 100 commits. Raise when a token is configured.
COMMITS_MAX_PAGES=5
ANALYSIS_CACHE_TTL_SECONDS=600

# Host port of the web UI
APP_PORT=8080
